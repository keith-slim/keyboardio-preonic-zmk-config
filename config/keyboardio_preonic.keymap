#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>

// 親指LT機能の連打バグ防止設定
&lt { quick_tap_ms = <200>; };

/ {
    chosen {
        // すべて1Uの均等な格子状（Orthoレイアウト）を明示
        zmk,physical-layout = &ortho_layout;
    };

    // ── Bluetooth切り替えと同時にLEDインジケータを連動させるカスタムマクロ定義 ──
    macros {
        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&rgb_ug RGB_COLOR_HSB(128,100,10)>,
                <&bt BT_SEL 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&rgb_ug RGB_COLOR_HSB(0,100,10)>,
                <&bt BT_SEL 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&rgb_ug RGB_COLOR_HSB(300,100,10)>,
                <&bt BT_SEL 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&rgb_ug RGB_COLOR_HSB(250,100,10)>,
                <&bt BT_SEL 3>;
        };
        bt_4: bt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&rgb_ug RGB_COLOR_HSB(50,100,10)>,
                <&bt BT_SEL 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ==========================================
        // レイヤー 0 : デフォルト（Base）レイヤー
        // ==========================================
        base_layer {
            label = "Base";
            bindings = <
// ── 最上段：ノブ周辺（3キー分） ──────────────────────────────────
 &trans      &mo 3       &kp C_PP

// ── メイングリッド（12列 × 5段） ─────────────────────────────────
 &kp ESC     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp BKSP
 &kp GRAVE   &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y       &kp U       &kp I       &kp O       &kp P       &kp MINUS
 &kp TAB     &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp SEMI    &kp ENTER
 &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp COMMA   &kp PERIOD  &kp UP      &kp SQT
 &kp LCTRL   &kp LGUI    &kp LALT    &mo 3       &mo 1       &kp SPACE   &kp DEL     &mo 2       &kp SLASH   &kp LEFT    &kp DOWN    &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;            
        };

        // ==========================================
        // レイヤー 1 : テンキー（Lower）レイヤー
        // ==========================================
        lower_layer {
            label = "Lower";
            bindings = <
 &trans      &trans      &kp HOME

 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS &kp KP_EQUAL
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_N7   &kp KP_N8     &kp KP_N9       &kp KP_MINUS &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_N4   &kp KP_N5     &kp KP_N6       &kp KP_PLUS  &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &kp KP_N1   &kp KP_N2     &kp KP_N3       &kp KP_PLUS  &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &kp BKSP    &kp KP_N0   &kp KP_DOT    &trans          &kp KP_ENTER &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        // ==========================================
        // レイヤー 2 : 記号・ファンクション（Raise）レイヤー
        // ==========================================
        raise_layer {
            label = "Raise";
            bindings = <
 &kp F11     &kp F12     &trans

 &kp ESC     &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp DEL
 &kp GRAVE   &trans      &trans      &trans      &trans      &trans      &kp BSLH    &kp LBRC    &kp RBRC    &kp LBKT    &kp RBKT    &kp BKSP
 &kp CAPS    &trans      &trans      &trans      &trans      &trans      &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans      &trans
 &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &kp RALT    &trans      &trans      &trans      &trans      &trans      &kp C_PREV  &kp C_PP    &kp C_NEXT  &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        // ==========================================
        // レイヤー 3 : システム・メディア（Function）レイヤー 【LEDマクロ適用】
        // ==========================================
        func_layer {
            label = "Function";
            bindings = <
 &trans      &trans      &trans

 &out OUT_TOG &bt_0        &bt_1        &bt_2        &bt_3        &bt_4        &trans      &trans      &trans      &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI
 &trans      &trans      &kp C_VOL_UP &trans      &trans      &trans      &trans      &trans      &trans      &trans      &rgb_ug RGB_EFF &rgb_ug RGB_EFR
 &trans      &kp C_PREV  &kp C_VOL_DN &kp C_NEXT  &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &trans      &trans      &kp C_MUTE   &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans
 &bootloader &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &bt BT_CLR
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };
};
